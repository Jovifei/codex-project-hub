{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Hub Event v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "event_id",
        "project_id",
        "agent_id",
        "run_id",
        "worktree_id",
        "branch",
        "expected_revision",
        "reported_at",
        "is_test",
        "reported_status",
        "stage_id",
        "current",
        "next",
        "blockers",
        "versions",
        "tests",
        "artifacts",
        "acceptance_claims"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "status"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "description": "Must be registered in the local catalog; no hard-coded project count."
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "worktree_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "reported_at": {
          "type": "string",
          "format": "date-time"
        },
        "is_test": {
          "type": "boolean"
        },
        "reported_status": {
          "enum": [
            "unknown",
            "active",
            "blocked",
            "paused",
            "claimed_complete"
          ]
        },
        "stage_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "current": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "next": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "blockers": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "versions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "tests": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "acceptance_claims": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "event_id",
        "project_id",
        "agent_id",
        "run_id",
        "worktree_id",
        "branch",
        "expected_revision",
        "reported_at",
        "is_test",
        "goal",
        "acceptance",
        "route"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "definition"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "description": "Must be registered in the local catalog; no hard-coded project count."
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "worktree_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "reported_at": {
          "type": "string",
          "format": "date-time"
        },
        "is_test": {
          "type": "boolean"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          }
        },
        "route": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "detail"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "event_id",
        "project_id",
        "agent_id",
        "run_id",
        "worktree_id",
        "branch",
        "expected_revision",
        "reported_at",
        "is_test",
        "acceptance_id",
        "outcome",
        "evidence_refs",
        "reviewer",
        "note",
        "verified_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "verification"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "description": "Must be registered in the local catalog; no hard-coded project count."
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "worktree_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "reported_at": {
          "type": "string",
          "format": "date-time"
        },
        "is_test": {
          "type": "boolean"
        },
        "acceptance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "outcome": {
          "enum": [
            "verified",
            "reopened"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  ]
}